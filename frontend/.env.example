# API origin for the SPA (no trailing slash). Used by Vite at build/dev time.
# If unset, defaults to same hostname as the page + :8001 (works for both
# http://localhost:5174 and http://127.0.0.1:5174).
# VITE_API_BASE_URL=http://localhost:8001

# When "true", sidebar and route guards allow all authenticated roles (mirrors DEMO_OPEN_RBAC).
# Leave unset/false for production-shaped RBAC.
# VITE_DEMO_OPEN_RBAC=true
