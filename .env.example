POSTGRES_USER=squadron_ops
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=squadron_ops
DATABASE_URL=postgresql+psycopg://squadron_ops:change-me-to-a-long-random-secret@127.0.0.1:5433/squadron_ops
TEST_DATABASE_URL=postgresql+psycopg://squadron_ops:change-me-to-a-long-random-secret@127.0.0.1:5433/squadron_ops_test

# --- App security (optional for local demo; required for production-shaped runs) ---
# Local portfolio demo: leave ENVIRONMENT unset/development. Demo JWT secret + seed
# password (demo1234) are intentional and documented in the README.
# ENVIRONMENT=development
# SECRET_KEY=squadron-ops-demo-secret-change-in-production

# Before any internet-facing deploy, use:
# ENVIRONMENT=production
# SECRET_KEY=<long random value, e.g. output of: openssl rand -hex 32>
# DEMO_OPEN_RBAC=false
