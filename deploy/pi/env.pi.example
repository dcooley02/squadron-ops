# Copy to /mnt/agent-data/agent/apps/squadron-ops/.env on the Pi (sync creates from this if missing).
# Tailscale-only demo host — not for public internet.

POSTGRES_USER=squadron_ops
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=squadron_ops

# App + Alembic (Postgres published on 127.0.0.1:5433 by docker compose)
DATABASE_URL=postgresql+psycopg://squadron_ops:CHANGE_ME_LONG_RANDOM@127.0.0.1:5433/squadron_ops

# Keep development so demo JWT / seed accounts work for portfolio demos.
# Do not set ENVIRONMENT=production with demo secrets.
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
DEMO_OPEN_RBAC=false

# Same-origin SPA + API (uvicorn :3091)
SQUADRON_OPS_STATIC_DIR=/mnt/agent-data/agent/apps/squadron-ops/frontend/dist

# Optional: comma-separated extra browser origins if you ever dual-port
# CORS_ORIGINS=http://100.66.35.41:3091
